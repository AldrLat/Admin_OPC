  object ADOQueryTableInformationSignals: TADOQuery
    Connection = DM.ADOConnectionWorkStationMDB
    CursorType = ctStatic
    BeforeScroll = ADOQueryTableInformationSignalsBeforeScroll
    AfterScroll = ADOQueryTableInformationSignalsAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT Points.*, Measurer.*, ParamLines.ColorBack,ParamLines.Umi' +
        'nNull,'
      'ParamLines.UmaxNull, LinkContr.* '
      
        '      FROM ((Points LEFT JOIN Measurer ON Points.Ms_Code = Measu' +
        'rer.Ms_Code) INNER JOIN LinkContr ON Points.Lc_Code = LinkContr.' +
        'Lc_Code) LEFT JOIN ParamLines ON Points.L_Code = ParamLines.L_Co' +
        'de '
      
        '      ORDER BY Measurer.L_Code, Points.Status, Points.Plata, Poi' +
        'nts.Point')
    Left = 144
    Top = 184
